# Application Environment Variables
ENVIRONMENT="development"
PROJECT_NAME="AI-Powered Resume Intelligence & Job Matching System"
API_V1_STR="/api/v1"
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8000

# Database (PostgreSQL / SQLite fallback for local test)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/resume_intelligence"
DATABASE_ECHO=false

# Security & Limits
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB limit
ALLOWED_MIME_TYPES='["application/pdf"]'

# NLP & Embedding Model
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
SPACY_MODEL="en_core_web_sm"

# Scoring Engine Weights (Normalized to 1.0)
WEIGHT_SKILL_MATCH=0.35
WEIGHT_SEMANTIC_MATCH=0.25
WEIGHT_EXPERIENCE_MATCH=0.20
WEIGHT_EDUCATION_MATCH=0.10
WEIGHT_PROJECT_MATCH=0.10

# AI Studio Platform Keys
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
